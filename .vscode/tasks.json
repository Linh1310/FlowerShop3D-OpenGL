{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build Flower Shop demo",
      "type": "shell",
      "command": "g++",
      "args": [
        "-g", "-std=c++17", "-Iinclude",
        "main.cpp",
        "src/bezier.cpp", "src/camera.cpp", "src/flowers.cpp",
        "src/interaction.cpp", "src/lighting.cpp", "src/model3d.cpp",
        "src/order.cpp", "src/people.cpp", "src/scene.cpp", "src/shop.cpp", "src/ui.cpp",
        "-o", "flower_shop.exe",
        "-lfreeglut", "-lopengl32", "-lglu32"
      ],
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$gcc"]
    }
  ]
}
